comment1.text=\r\n\ Konstruktor\:\ setzt\ die\ Startwerte\ und\ erstellt\ das\ Schiff-Bild.\r\n
comment2.params=
comment2.target=void\ act()
comment2.text=\r\n\ Wird\ von\ Greenfoot\ bei\ jedem\ Simulationsschritt\ aufgerufen.\r\n
comment3.params=
