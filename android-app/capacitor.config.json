{
  "appId": "io.github.bsxray.spaceshooter",
  "appName": "SpaceShooter",
  "webDir": "www",
  "android": {
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": false,
      "backgroundColor": "#090b16",
      "showSpinner": false
    },
    "CapacitorUpdater": {
      "autoUpdate": false
    }
  }
}
